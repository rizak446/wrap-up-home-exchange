# ==============================================================================
# HavenSwap Platform Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or secret keys into source control.

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project Settings -> API:
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# CRITICAL: Keep SUPABASE_SERVICE_ROLE_KEY private on the server. Never expose to client!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# MAPS & LOCATION PLATFORM
# ------------------------------------------------------------------------------
# HavenSwap provides an interactive Leaflet/OpenStreetMap engine out-of-the-box
# with zero external billing barriers. If you wish to enable Google Maps or Mapbox:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...
# Or Mapbox:
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijo...

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (RAZORPAY FOR INDIA / STRIPE GLOBAL)
# ------------------------------------------------------------------------------
# Required for live membership subscription billing and verified server webhooks.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret...
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret...

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (RESEND / SENDGRID)
# ------------------------------------------------------------------------------
# Used for verified booking notifications, stay reminders, and email verification.
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=HavenSwap Notifications <noreply@havenswap.com>

# ------------------------------------------------------------------------------
# IDENTITY VERIFICATION PROVIDER (DIGILOCKER / HYPERVERGE / IDFY)
# ------------------------------------------------------------------------------
# Indian identity verification gateway credentials. Fallback to manual review is built-in.
IDENTITY_PROVIDER_CLIENT_ID=...
IDENTITY_PROVIDER_SECRET=...
